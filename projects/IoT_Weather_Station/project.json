    {"from": "ESP32 GPIO4", "to": "DHT22 Data Pin", "color": "#00ff88", "notes": "1-Wire Digital Signal (10k Pullup)"},
    {"from": "ESP32 3.3V", "to": "OLED / DHT22 / BMP280 VCC", "color": "#ff4d4d", "notes": "3.3V Regulated Power Rail"},
    {"from": "ESP32 GND", "to": "Common Sensor GND", "color": "#4a5568", "notes": "Ground wire"}
