    {"name": "BMP280 Barometric Pressure Sensor", "quantity": 1, "specs": "I2C/SPI atmospheric sensor"},
    {"name": "0.96 inch I2C OLED Display (SSD1306)", "quantity": 1, "specs": "128x64 pixels monochrome"},
    {"name": "10k Ohm Resistor", "quantity": 1, "specs": "Pull-up resistor for DHT22 data line"}
  ],
  "serialPlayback": [
    "[SYSTEM] IoT Weather Station Bootstrapped.",
