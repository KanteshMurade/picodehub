# Copy this file to .env for local development.
# On Render, set these same keys under Environment Variables instead.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=picodehub

# --- Flask ---
PICODEHUB_SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# --- Default admin account (created automatically on first run, ONLY if
#     no admin exists yet). This is a TEMPORARY login — after you deploy,
#     log in with these, open the user menu -> Change Password, and set
#     your real password. You can then remove these two lines. ---
PICODEHUB_ADMIN_USER=admin
PICODEHUB_ADMIN_PASS=PicodeTemp@2026
PICODEHUB_ADMIN_EMAIL=you@example.com

# --- Email (Brevo preferred -- free tier sends to ANY recipient, no
#     domain verification needed. Resend also supported as a fallback.) ---
# Get a free API key at https://www.brevo.com (300 emails/day free)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=you@example.com
BREVO_FROM_NAME=PiCodeHub

# Only used if BREVO_API_KEY is not set:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=PiCodeHub <onboarding@resend.dev>

# Public URL of your deployed site (used to build the verification link).
# Locally: http://localhost:5000
# On Render: https://your-app-name.onrender.com
SITE_URL=http://localhost:5000
